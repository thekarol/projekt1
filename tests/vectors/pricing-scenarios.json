      "expect": { "total": 0, "priceStatus": "toBeAgreed", "onlinePaymentAllowed": false, "toBeAgreed": [{ "code": "longerThanPackages", "refId": "ns-m" }], "lines": [{ "unitPrice": null, "lineTotal": null }] }
    },
    {
