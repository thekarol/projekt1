      "patch": { "dateExceptions": [{ "id": "t-custom", "from": "2027-07-10", "to": "2027-07-10", "action": { "kind": "customPrices", "prices": [{ "variantId": "ns-m", "bandId": "days2", "amount": 45100 }] } }] },
      "order": { "mode": "days", "startDate": "2027-07-10", "endDate": "2027-07-11", "items": [{ "variantId": "ns-m", "quantity": 1 }], "services": [] },
      "expect": { "total": 45100 }
