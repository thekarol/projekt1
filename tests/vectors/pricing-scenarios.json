      "expect": { "total": 25000, "priceStatus": "final", "lines": [{ "method": { "code": "dayByHours" } }] }
    },
    {
      "name": "1 godzina to cena krótkiego najmu",
      "order": { "mode": "hours", "startDate": "2027-07-06", "endDate": "2027-07-06", "startMinute": 600, "endMinute": 660, "items": [{ "variantId": "ns-m", "quantity": 1 }], "services": [] },
      "expect": { "total": 20000, "lines": [{ "method": { "code": "short", "maxHours": 4 } }] }
    },
    {
