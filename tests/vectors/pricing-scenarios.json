      "order": { "mode": "days", "startDate": "2027-05-20", "endDate": "2027-05-21", "items": [{ "variantId": "ns-m", "quantity": 1 }], "services": [] },
      "expect": { "total": 44500, "dateDifference": -500 }
    },
    {
